# Linux/NAS paths used by docker-compose.yml.
ISACG_SOURCE_DIR=/vol1/images
ISACG_ACG_DIR=/vol1/acg
ISACG_NON_ACG_DIR=/vol1/non_acg

# Preload only the default model to reduce startup time and memory.
# Use v1s,v1,v2 when all model switches should be instant.
ISACG_PRELOAD_MODELS=v1s

# One ONNX Runtime thread per classification worker is a good NAS default.
ORT_INTRA_OP_THREADS=1
ORT_INTER_OP_THREADS=1
WAITRESS_THREADS=4
JOB_SAVE_INTERVAL=0.75
JOB_HISTORY_LIMIT=30

# Optional: override base images when your NAS needs a different mirror.
PYTHON_SLIM_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm

# Optional when the container is not running as root.
# ISACG_RENDER_GID=109

# Optional: force Mesa Vulkan to expose a specific GPU only.
# Find vendorID:deviceID with `vulkaninfo --summary`.
MESA_VK_DEVICE_SELECT=8086:3e96!
