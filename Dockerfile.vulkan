ARG PYTHON_SLIM_IMAGE=docker.m.daocloud.io/library/python:3.12-slim-bookworm

FROM ${PYTHON_SLIM_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TZ=CST-8

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libvulkan1 \
       mesa-vulkan-drivers \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-vulkan.txt ./
RUN python3 -m pip install --no-cache-dir -r requirements-vulkan.txt \
    && python3 -c "import watchdog; print('watchdog: ok')" \
    && python3 -c "import onnxruntime as ort; import onnxruntime_ep_webgpu as webgpu; print('ORT providers:', ort.get_available_providers()); print('WebGPU EP:', webgpu.get_ep_name(), webgpu.get_library_path())"

COPY app.py folder_service.py job_service.py serve.py ./
COPY templates ./templates
COPY static ./static
COPY models ./models

RUN mkdir -p /app/config /app/storage /tmp/runtime-root \
    && chmod 700 /tmp/runtime-root

EXPOSE 8080

VOLUME ["/app/storage", "/app/config"]

CMD ["python3", "serve.py"]
